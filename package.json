{
  "name": "project-darwin",
  "version": "0.1.0",
  "description": "A representation-blind neuroevolution engine, hand-written in TypeScript.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "experiment": "node --experimental-transform-types --import ./scripts/ts-import-hook.mjs src/headless/runExperiment.ts",
    "bench": "node --experimental-transform-types --import ./scripts/ts-import-hook.mjs src/headless/runBench.ts"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
